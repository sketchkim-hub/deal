# ── 사이트 ──────────────────────────────────────────
SITE_NAME=오늘의특가
# 게시될 사이트 주소 (도메인 연결 후 실제 주소로). 공유 미리보기·sitemap·CNAME에 사용
SITE_URL=https://example.com
# 도메인 없이 https://아이디.github.io/저장소이름/ 으로 볼 때만 입력 (예: /teukga-site). 도메인 연결 후엔 비워 두세요
BASE_PATH=

# ── 관리자 화면 (이 PC에서만 열림) ─────────────────────
PORT=3000
HOST=127.0.0.1
# HOST 가 127.0.0.1 이면 비워 둬도 됩니다. 다른 기기에서 접속하게 열 경우 반드시 설정 (아이디: admin)
ADMIN_PASSWORD=

# ── 특가 기준 ────────────────────────────────────────
MIN_DISCOUNT=15
# 가격을 이 시간 동안 갱신하지 않으면 사이트에서 숨김
STALE_HOURS=48
# 대시보드 '갱신 필요' 목록에 올라가는 기준 시간
REFRESH_HOURS=20

# ── 가격 확인 ────────────────────────────────────────
# off (권장): 크롬의 '⚡ 특가 담기' 버튼으로 가격을 넣습니다
# on: 프로그램이 쿠팡 페이지를 직접 읽음 — 쿠팡이 차단하며 약관상 권장하지 않음
MONITOR_MODE=off
# 한국 시간 기준, 쉼표로 구분. MONITOR_MODE=on 일 때와 API 골드박스 후보 수집에 사용
CHECK_TIMES=09:00,15:00,21:00

# ↓ MONITOR_MODE=on 일 때만 쓰는 설정
# auto : 일반 요청 → 차단되면 Chromium으로 재시도
# http : 일반 요청만 / browser : Chromium만 (npm i playwright 필요)
FETCH_MODE=auto
# 한국 IP가 아니면 확인을 중단 (VPN 켜져 있으면 중단됨)
REQUIRE_KR_IP=true
# 상품 사이 대기 시간(ms)
DELAY_MIN_MS=3000
DELAY_MAX_MS=8000
# 설치된 Chrome 경로를 직접 지정할 때 (선택). 예: C:\Program Files\Google\Chrome\Application\chrome.exe
# BROWSER_PATH=

# ── 게시 (github | firebase | none) ─────────────────
PUBLISH_TARGET=github

# GitHub Pages: 사이트 파일을 올릴 저장소와 브랜치
GITHUB_REPO_URL=https://github.com/아이디/teukga-site.git
GITHUB_BRANCH=gh-pages
# 저장소 쓰기 권한이 있는 토큰 (Fine-grained token → 해당 저장소만, Contents: Read and write)
GITHUB_TOKEN=

# Firebase Hosting: 프로젝트 ID (처음 한 번 `npx firebase-tools login` 필요)
FIREBASE_PROJECT=

# ── 후보 자동 탐색 (기본 꺼짐) ───────────────────────
DISCOVER_URLS=

# ── 쿠팡 파트너스 Open API (승인 후 입력) ────────────
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=
